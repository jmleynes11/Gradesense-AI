PORT=5000
MONGO_URI=your_mongodb_connection
JWT_SECRET=your_jwt_secret
GROQ_API_KEY=your_groq_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_ESSAY_REVIEW_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=your_openai_key
OPENAI_MODEL=gpt-4o-mini
# Optional: base64-encoded 32-byte AES key for protected essay answer/rubric/feedback logs.
# Without it, content is redacted and only fingerprints and numeric metadata are logged.
# AI_ESSAY_LOG_ENCRYPTION_KEY=
AI_QUIZ_TOTAL_TIMEOUT_MS=65000
AI_QUIZ_REQUEST_TIMEOUT_MS=20000
AI_QUIZ_RETRY_DELAY_MS=500
AI_QUIZ_MAX_RETRY_DELAY_MS=1500
AI_QUIZ_MAX_OUTPUT_TOKENS=8000
AI_QUIZ_RECOVERY_EXTRA_MC=2
